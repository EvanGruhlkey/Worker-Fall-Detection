# Settings for the backend. `uv run run.py` copies this file to .env on the
# first run; edit .env (not this file) to change your own settings.
# Variables set in the terminal take precedence over this file.

# Optional camera to start automatically when the backend boots. Leave this
# empty to choose a local camera or network stream from the dashboard.
FALL_CAMERA_SOURCE=
FALL_CAMERA_NAME=Camera 01
FALL_CAMERA_LABEL=Webcam

# Location: the dashboard uses the computer's own location (the browser asks
# for permission once). These are used only until then, or if it's blocked.
FALL_SITE_LOCATION=Unspecified location
FALL_SITE_COORDS=

# Set to 0 to stop sending coordinates to OpenStreetMap to look up the city
# name; the dashboard then shows the coordinates instead.
FALL_REVERSE_GEOCODE=1
