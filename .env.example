# Settings for the backend. `uv run run.py` copies this file to .env on the
# first run; edit .env (not this file) to change your own settings.
# Variables set in the terminal take precedence over this file.

# Optional camera to start automatically when the backend boots. Leave this
# empty to choose a local camera or network stream from the dashboard.
FALL_CAMERA_SOURCE=
FALL_CAMERA_NAME=Camera 01
FALL_CAMERA_LABEL=Webcam

# Location: the dashboard uses the computer's own location (the browser asks
# for permission once). These are used only until then, or if it's blocked.
FALL_SITE_LOCATION=Unspecified location
FALL_SITE_COORDS=

# Set to 0 to stop sending coordinates to OpenStreetMap to look up the city
# name; the dashboard then shows the coordinates instead.
FALL_REVERSE_GEOCODE=1

# YOLO inference size. "native" runs the model at the camera's own resolution
# so people far from the camera are still found; a number such as 640 scales
# the long side down to it, which is about 3x faster on a CPU but misses
# people who are small in the frame.
FALL_IMAGE_SIZE=native

# Fall detector: leave empty for the rule-based placeholder, or point at a
# newly trained body-only temporal classifier, e.g. models/fall_gru_body12.pt
# The old models/fall_gru.pt requires retraining.
# (train one with `uv run scripts/train_temporal.py --synthetic 1500`).
FALL_CLASSIFIER_PATH=

# Shared database and media storage (see docs/database.md). Every station
# (laptop) on the team uses the same values, so everyone sees every fall.
# Get them from a teammate over a private channel; never commit them.
#
# Supabase: Project Settings > Database > Connection string > "Session pooler"
# (not "Direct connection", which needs IPv6). Change the start to
# postgresql+psycopg:// and fill in the database password.
FALL_DATABASE_URL=
# Supabase: Storage > S3 Connection (endpoint, region) and Access keys.
FALL_STORAGE_ENDPOINT=
FALL_STORAGE_REGION=
FALL_STORAGE_BUCKET=
FALL_STORAGE_KEY_ID=
FALL_STORAGE_SECRET=

# This computer's name in the shared database (default: its network name).
FALL_STATION_NAME=

# Only without FALL_DATABASE_URL: a PostgreSQL server you run yourself, set up
# with `uv run scripts/create_db.py`. Use a strong password.
FALL_DB_HOST=localhost
FALL_DB_PORT=5432
FALL_DB_NAME=fall_detection
FALL_DB_USER=fall
FALL_DB_PASSWORD=fall
